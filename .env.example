# AFRICHESS Environment Variables
# Copy to .env and adjust for your environment

# Django
SECRET_KEY=your-super-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,africhess.com
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (POSTGRES_PORT=5433 si Postgres tourne via docker-compose — mapping hôte 5433→5432)
POSTGRES_DB=africhess
POSTGRES_USER=africhess
POSTGRES_PASSWORD=africhess_dev_pg
REDIS_PASSWORD=africhess_redis_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Redis (mot de passe requis en docker-compose local)
REDIS_URL=redis://:africhess_redis_dev@localhost:6379/0
WS_ALLOW_QUERY_TOKEN=false
PREMIUM_DEMO_ALLOWED=false
ALLOW_PUBLIC_API_DOCS=false
DISCONNECT_FORFEIT_SECONDS=90

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://africhess.com

# Chess Engine
STOCKFISH_PATH=/usr/games/stockfish
ENGINE_DEPTH=18
FAIRPLAY_BIN=/usr/local/bin/africhess-fairplay

# Matchmaking
MATCHMAKING_ELO_RANGE=200

# Push notifications (Expo → APNs/FCM, Web Push VAPID)
PUSH_NOTIFICATIONS_ENABLED=true
EXPO_ACCESS_TOKEN=
# Générer avec: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@africhess.com

# Stripe (obligatoire en production — pas de mode démo hors DEBUG)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GOLD=
STRIPE_PRICE_DIAMOND=

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
NEXT_PUBLIC_MEDIA_ORIGIN=http://127.0.0.1:8000
# HttpOnly refresh cookie (backend JWT_REFRESH_HTTPONLY=true requis)
JWT_REFRESH_HTTPONLY=false
NEXT_PUBLIC_JWT_REFRESH_HTTPONLY=false

# OAuth (optional — voir docs/PREMIUM_OAUTH_SETUP.md)
FRONTEND_URL=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Frontend OAuth toggle (affiche les boutons Google/GitHub)
NEXT_PUBLIC_OAUTH_ENABLED=false
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8000
