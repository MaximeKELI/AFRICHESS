  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "WebSocket — temps réel",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum(africhess_ws_connections_active) by (tier)",
          "legendFormat": "{{tier}}",
          "refId": "A"
        }
      ],
      "title": "Connexions WS actives",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "cps"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(africhess_ws_connections_total[5m])) by (tier)",
          "legendFormat": "{{tier}}",
          "refId": "A"
        }
      ],
      "title": "Taux de nouvelles connexions WS",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5000 },
              { "color": "red", "value": 15000 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(africhess_ws_connections_active)",
          "refId": "A"
        }
      ],
      "title": "Total WS actives (gauge)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Matchmaking",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(africhess_matchmaking_latency_seconds_bucket[5m])) by (le, status))",
          "legendFormat": "p50 {{status}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(africhess_matchmaking_latency_seconds_bucket[5m])) by (le, status))",
          "legendFormat": "p99 {{status}}",
          "refId": "B"
        }
      ],
      "title": "Latence matchmaking Redis (p50 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "targets": [
        {
          "expr": "africhess_matchmaking_queue_size",
          "legendFormat": "en attente",
          "refId": "A"
        }
      ],
      "title": "Joueurs en file matchmaking",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Celery — queues",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(africhess_celery_task_duration_seconds_bucket[5m])) by (le, queue))",
          "legendFormat": "p95 {{queue}}",
          "refId": "A"
        }
      ],
      "title": "Durée tâches Celery p95 par queue",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 7,
      "targets": [
        {
          "expr": "sum(rate(africhess_celery_tasks_total[5m])) by (queue, status)",
          "legendFormat": "{{queue}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "Débit tâches Celery",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "id": 8,
      "targets": [
        {
          "expr": "redis_db_keys{db=\"db2\"}",
          "legendFormat": "celery keys db2",
          "refId": "A"
        },
        {
          "expr": "sum(redis_connected_clients)",
          "legendFormat": "clients redis",
          "refId": "B"
        }
      ],
      "title": "Redis — backlog / clients (redis_exporter)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
