# Production — copier vers infra/.env.production

# Django
SECRET_KEY=change-me-minimum-fifty-random-characters-for-production-use
ALLOWED_HOSTS=api.africhess.com,ws.africhess.com,localhost
CORS_ALLOWED_ORIGINS=https://africhess.com,https://www.africhess.com
FRONTEND_URL=https://africhess.com

# Postgres
POSTGRES_DB=africhess
POSTGRES_USER=africhess
POSTGRES_PASSWORD=change-me-strong-pg-password
REPLICATION_PASSWORD=change-me-replication-password
USE_READ_REPLICA=true

# Redis (mono-nœud dev ; en prod AWS ElastiCache Cluster ou 3+ nœuds)
REDIS_PASSWORD=change-me-redis-password
# CSV pour cluster Channels (ex. 3 masters) :
# REDIS_CHANNELS_URLS=redis://:pass@redis-1:6379/1,redis://:pass@redis-2:6379/1,redis://:pass@redis-3:6379/1

# Scale (docker compose / K8s)
API_REPLICAS=4
WS_REPLICAS=8
API_WORKERS=4
CELERY_ANALYSIS_REPLICAS=4
CELERY_FAIRPLAY_REPLICAS=4
CELERY_ANALYSIS_CONCURRENCY=2
CELERY_FAIRPLAY_CONCURRENCY=2

# Observabilité
GRAFANA_PASSWORD=change-me-grafana
PROMETHEUS_METRICS_ENABLED=true

# Stripe / OAuth (production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
